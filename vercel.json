{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/catalogo.html/",
      "destination": "/src/pages/selecao.html"
    },
    {
      "source": "/catalogo.html/:galeria/",
      "destination": "/src/pages/selecao.html?g=:galeria"
    },
    {
      "source": "/catalogo.html/:galeria",
      "destination": "/src/pages/selecao.html?g=:galeria"
    },
    { "source": "/api/entrega", "destination": "/api/selecao?modo=entrega" },
    { "source": "/api/galerias", "destination": "/api/selecao?modo=galerias" },
    { "source": "/api/galeria", "destination": "/api/selecao?modo=galeria" },
    {
      "source": "/",
      "destination": "/src/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/src/index.html"
    },
    {
      "source": "/config",
      "destination": "/src/admin/index.html"
    },
    {
      "source": "/painel",
      "destination": "/src/admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/src/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/src/admin/:path*"
    },
    {
      "source": "/catalogo",
      "destination": "/src/pages/selecao.html"
    },
    {
      "source": "/catalogo.html",
      "destination": "/src/pages/selecao.html"
    },
    {
      "source": "/login",
      "destination": "/src/login.html"
    },
    {
      "source": "/login.html",
      "destination": "/src/login.html"
    },
    {
      "source": "/robots.txt",
      "destination": "/public/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/public/sitemap.xml"
    },
    {
      "source": "/pages/:path*",
      "destination": "/src/pages/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/src/js/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "/src/css/:path*"
    },
    {
      "source": "/img/:path*",
      "destination": "/src/img/:path*"
    },
    {
      "source": "/font/:path*",
      "destination": "/src/font/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://vercel.live; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/config",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/catalogo.html/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/font/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
