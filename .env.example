# Copie para .env e preencha. O .env NÃO vai para o repositório.
# Em produção, estes valores vivem em
# Vercel > Settings > Environment Variables.

# Postgres. Funciona com Neon, Supabase (só como banco), Railway
# ou um Postgres nosso numa VPS.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Hash da senha do painel. Gere com: npm run hash
ADMIN_PASSWORD_HASH=

# Chave que assina o cookie de sessão. Gere com: npm run secret
SESSION_SECRET=
