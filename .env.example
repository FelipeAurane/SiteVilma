# Credenciais do painel e do servidor.
# Copie para .env e preencha. O .env nunca vai para o git; na Vercel as mesmas
# variáveis ficam em Settings > Environment Variables.

# PIN de 4 dígitos que abre o painel /config
ADMIN_PIN=

# Connection string do Postgres (sslmode=require)
DATABASE_URL=

# Gere com: npm run secret
SESSION_SECRET=

# Porta do servidor local (a Vercel define a dela)
PORT=3000

NODE_ENV=development

# Só para desenvolvimento. Com DATABASE_URL preenchida o servidor usa o
# Postgres de verdade e, se a conexão cair, devolve erro em vez de gravar num
# banco em memória que se perde ao reiniciar. Coloque 1 para permitir o banco
# em memória mesmo com a variável preenchida (útil em teste automatizado).
ALLOW_MEMORY_DB=

# Origens extras autorizadas a fazer escrita no painel, separadas por vírgula.
# Só é preciso se o painel for aberto por um domínio diferente do que serve a
# API. Em uso normal, deixe vazio.
ALLOWED_ORIGINS=

# Coloque 1 só para Postgres local sem certificado. Nunca em produção.
DATABASE_SSL_INSECURE=